[Unit]
Description=Lwa MCP local telemetry summary

[Service]
Type=oneshot
WorkingDirectory=%h/Documents/Documents/code/lwa-mcp
ExecStart=%h/Documents/Documents/code/lwa-mcp/scripts/lwa-maintenance.sh telemetry
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/.local/state/lwa-mcp %h/.local/share/lwa-mcp %h/.config/lwa-mcp
StandardOutput=journal
StandardError=journal
