#!/usr/bin/env python3
"""Run the local, non-promoting Lwa release gates."""
from __future__ import annotations

import os
import subprocess
import sys
from pathlib import Path


def main() -> int:
    root = Path(__file__).resolve().parents[1]
    python = root / ".venv" / "bin" / "python"
    if not python.exists():
        python = Path(sys.executable)
    commands = [
        [str(python), "-m", "pytest", "-q"],
        [str(python), "-m", "compileall", "-q", "src/lwa_mcp"],
        ["git", "diff", "--check"],
    ]
    for command in commands:
        result = subprocess.run(command, cwd=root, check=False)
        if result.returncode:
            return result.returncode
    image = os.environ.get("LWA_SANDBOX_IMAGE")
    if image:
        probe = [str(python), "-c", "from lwa_mcp.sandbox_executor import probe_sandbox; import sys; r=probe_sandbox('/tmp/lwa-release-check', image=sys.argv[1]); print(r); raise SystemExit(0 if r.get('verified') else 1)", image]
        result = subprocess.run(probe, cwd=root, check=False)
        if result.returncode:
            return result.returncode
    else:
        print("LWA_SANDBOX_IMAGE not set; image probe skipped", file=sys.stderr)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
